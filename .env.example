# ==========================================
# 3D Web Portfolio - Environment Variables
# ==========================================
# Copy this file to .env.local and fill in the values.
# DO NOT commit real secrets or API keys to version control.

# ------------------------------------------
# 1. Supabase Configuration (Database & Auth & Vector)
# ------------------------------------------
# Project URL (Project Settings > API). Not secret.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Secret key (sb_secret_...) or legacy service_role key. Server only: NEVER expose
# it to the browser or prefix it with NEXT_PUBLIC_. The chatbot and ingest use it.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Supabase Database Direct URL (Optional: for migrations / direct pg connection)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-ID].supabase.co:5432/postgres

# ------------------------------------------
# 2. Portfolio assistant (RAG chatbot): Google Gemini API
# ------------------------------------------
# Server-only. Create a key at https://aistudio.google.com/apikey (free tier).
GEMINI_API_KEY=your-gemini-api-key

# Optional overrides (defaults shown). Changing the embedding model or size
# means re-running `npm run ingest -- --force`; the size must match the
# vector(768) column in supabase/migrations/001_knowledge_chunks.sql.
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
# EMBEDDING_DIMENSIONS=768
# GEMINI_THINKING_LEVEL=

# Retrieval tuning: how many chunks to fetch, and the minimum cosine
# similarity (0-1) for a chunk to count as relevant. Below it, the assistant
# says the information isn't in the portfolio instead of guessing.
# RAG_MATCH_COUNT=6
# RAG_MIN_SIMILARITY=0.58

# Requests per visitor (per server instance).
# CHAT_RATE_LIMIT_PER_MINUTE=8
# CHAT_RATE_LIMIT_PER_HOUR=60

# ------------------------------------------
# 3. Contact Station email (Resend)
# ------------------------------------------
# All three are server-only. The form sends nothing until all three are set,
# so leave them out of Vercel until delivery has been tested and the
# recipient confirmed. Setup: docs/contact.md.
#
# API key from https://resend.com/api-keys (Sending access is enough).
RESEND_API_KEY=re_your_resend_api_key
# The only recipient. Visitors cannot change it.
CONTACT_EMAIL=your-confirmed-email@example.com
# A sender Resend accepts. Without a verified domain use onboarding@resend.dev,
# which only delivers to the email address your Resend account was created with.
RESEND_FROM_EMAIL=Muzna's Creative World <onboarding@resend.dev>

# ------------------------------------------
# 4. Application Configuration
# ------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NODE_ENV=development
