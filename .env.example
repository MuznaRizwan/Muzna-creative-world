# ==========================================
# 3D Web Portfolio - Environment Variables
# ==========================================
# Copy this file to .env.local and fill in the values.
# DO NOT commit real secrets or API keys to version control.

# ------------------------------------------
# 1. Supabase Configuration (Database & Auth & Vector)
# ------------------------------------------
# Public client credentials (safe to expose to browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Service role key (Backend only - NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Supabase Database Direct URL (Optional: for migrations / direct pg connection)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-ID].supabase.co:5432/postgres

# ------------------------------------------
# 2. AI & RAG Chatbot Configuration
# ------------------------------------------
# OpenAI API Key (used for vector embeddings and chat responses)
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# (Alternative) Google Gemini API Key (if using Gemini for embeddings/LLM)
# GEMINI_API_KEY=your-gemini-api-key

# ------------------------------------------
# 3. Email Communication (Resend API)
# ------------------------------------------
RESEND_API_KEY=re_your_resend_api_key
CONTACT_EMAIL_TO=your-email@example.com
CONTACT_EMAIL_FROM=Portfolio Contact <onboarding@resend.dev>

# ------------------------------------------
# 4. Application Configuration
# ------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NODE_ENV=development
