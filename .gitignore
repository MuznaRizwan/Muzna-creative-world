# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
*.pem

# debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files (secrets); only the template is committed
.env*
!.env.example

# vercel
.vercel

# local editor / agent tooling
/.claude/
/.vscode/
/.idea/

# typescript artefacts (the app is JavaScript; these may appear from tooling)
*.tsbuildinfo
next-env.d.ts

# Blender auto-saves and backups
*.blend1
*.blend2
*.blend@

# Adobe After Effects temp files
*.aep~
Adobe After Effects Auto-Save/
.aeswap*

# Art source files: the .blend, .aep, footage, scripts and fonts are committed.
# Left out: the lossless render (2.2 GB), AE logs, script logs, and the Mixkit
# audio files (their licence allows use in the video, not redistribution;
# art-source/after-effects/audio/LICENSES.txt lists each one).
/art-source/after-effects/render/
/art-source/after-effects/promotionalvideo.aep Logs/
/art-source/after-effects/scripts/*-log.txt
/art-source/after-effects/audio/**/*.mp3
/art-source/after-effects/audio/**/*.wav
# Font downloads (the site loads these fonts from Google; licences are kept)
/art-source/fonts/**/*.zip
/art-source/fonts/**/*.ttf
/art-source/fonts/**/*.otf

# chatbot knowledge preview (npm run ingest:preview)
knowledge-preview.md

# personal source material and design references (not part of the site)
/profile/
/visual_direction.pdf

# Submission archive (large binaries; built locally)
/submission/
/submission-archive/
